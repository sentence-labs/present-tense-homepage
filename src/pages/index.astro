  <meta name="twitter:description" content="Present Tense turns your live screen into shared, structured state: crisp text on every device, resilient on bad wifi. From Sentence Labs.">
  <meta name="twitter:image" content="https://present-tense.io/assets/og.png">

  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Present Tense",
      "url": "https://present-tense.io",
      "description": "Present Tense turns your live screen into shared, structured state: crisp text on every device, resilient on bad wifi.",
      "publisher": {
        "@type": "Organization",
        "name": "Sentence Labs",
        "url": "https://sentence-labs.com",
        "logo": "https://present-tense.io/assets/logo.svg",
        "email": "hi@sentence-labs.com"
      }
    }
  </script>
