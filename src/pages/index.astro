<body>

<div class="center">
  <div class="mark">
    <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g fill="currentColor">
        <circle cx="32" cy="23" r="6"/>
        <circle cx="32" cy="41" r="6"/>
      </g>
    </svg>
  </div>

  <h1 id="headline" aria-label="Present Tense">Present Tense</h1>

  <p class="description">A live presentation surface, from Sentence Labs, turning your screen into shared, structured state that stays sharp on every device.</p>

  <div class="diagram-wrap">
    <svg width="200" height="140" viewBox="0 0 200 140" aria-hidden="true">
      <line class="path-line" x1="100" y1="18" x2="34" y2="118"/>
      <line class="path-line" x1="100" y1="18" x2="100" y2="128"/>
      <line class="path-line" x1="100" y1="18" x2="166" y2="118"/>

      <circle cx="34" cy="118" r="4" fill="none" stroke="#8B8B85" stroke-width="1.2"/>
      <circle cx="100" cy="128" r="4" fill="none" stroke="#8B8B85" stroke-width="1.2"/>
      <circle cx="166" cy="118" r="4" fill="none" stroke="#8B8B85" stroke-width="1.2"/>

      <circle class="flash flash-1" cx="34" cy="118" r="4" fill="#F4F2EA"/>
      <circle class="flash flash-2" cx="100" cy="128" r="4" fill="#F4F2EA"/>
      <circle class="flash flash-3" cx="166" cy="118" r="4" fill="#F4F2EA"/>

      <circle class="pulse pulse-1" cx="100" cy="18" r="3" fill="#F4F2EA"/>
      <circle class="pulse pulse-2" cx="100" cy="18" r="3" fill="#F4F2EA"/>
      <circle class="pulse pulse-3" cx="100" cy="18" r="3" fill="#F4F2EA"/>

      <circle cx="100" cy="18" r="5" fill="#F4F2EA"/>
    </svg>
  </div>
  <p class="diagram-caption">One live source. Every screen resolves it locally.</p>

  <p class="status">Coming soon.</p>
  <p class="contact"><a href="mailto:hi@sentence-labs.com">hi@sentence-labs.com</a></p>
</div>

<footer>
  <p>Sentence Labs Private Limited · © 2026</p>
</footer>

<script is:inline>
  (function(){
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var el = document.getElementById('headline');
    var finalText = "Present Tense";

    if (reduceMotion) {
      el.textContent = finalText;
      return;
    }

    var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    var revealed = 0;

    var id = setInterval(function(){
      var out = "";
      for (var i = 0; i < finalText.length; i++) {
        if (finalText[i] === " ") { out += " "; continue; }
        if (i < revealed) { out += finalText[i]; }
        else { out += chars[Math.floor(Math.random() * chars.length)]; }
      }
      el.textContent = out;

      revealed += 0.6;
      if (revealed >= finalText.length) {
        el.textContent = finalText;
        clearInterval(id);
      }
    }, 35);
  })();
</script>
</body>
</html>

<style>
  :root{
    --bg: #0B0B0C;
    --offwhite: #F4F2EA;
    --muted: #8B8B85;
    --line: #302F2C;
    --footer-muted: #58585480;
  }

  *{ box-sizing: border-box; }

  html, body{
    margin: 0;
    height: 100%;
    background: var(--bg);
  }

  body{
    font-family: "Inter", -apple-system, sans-serif;
    color: var(--offwhite);
    -webkit-font-smoothing: antialiased;
  }

  a{ color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  a:hover{ color: var(--offwhite); }

  *:focus-visible{
    outline: 2px solid var(--offwhite);
    outline-offset: 3px;
  }

  .center{
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 24px 100px;
  }

  .mark{ margin: 0 0 24px; color: var(--offwhite); }
  .mark svg{ display: block; margin: 0 auto; }

  h1{
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
    min-height: 1.2em;
    font-variant-ligatures: none;
  }

  .description{
    width: 100%;
    font-size: 1.02rem;
    font-weight: 400;
    color: var(--muted);
    max-width: 420px;
    line-height: 1.6;
    margin: 0 0 8px;
  }

  /* -- diagram: one source, several receivers resolving -- */

  .diagram-wrap{ margin: 30px 0 14px; }

  .path-line{
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .flash{ opacity: 0; }
  .pulse{ opacity: 0; }

  @keyframes flashPulse{
    0%, 42% { opacity: 0; }
    46% { opacity: 1; }
    56% { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes travel1{
    0% { transform: translate(0px, 0px); opacity: 0; }
    6% { opacity: 1; }
    46% { transform: translate(-66px, 100px); opacity: 1; }
    50%, 100% { transform: translate(-66px, 100px); opacity: 0; }
  }
  @keyframes travel2{
    0% { transform: translate(0px, 0px); opacity: 0; }
    6% { opacity: 1; }
    46% { transform: translate(0px, 110px); opacity: 1; }
    50%, 100% { transform: translate(0px, 110px); opacity: 0; }
  }
  @keyframes travel3{
    0% { transform: translate(0px, 0px); opacity: 0; }
    6% { opacity: 1; }
    46% { transform: translate(66px, 100px); opacity: 1; }
    50%, 100% { transform: translate(66px, 100px); opacity: 0; }
  }

  .pulse-1{ animation: travel1 2.4s linear infinite; }
  .pulse-2{ animation: travel2 2.4s linear infinite; }
  .pulse-3{ animation: travel3 2.4s linear infinite; }

  .flash-1{ animation: flashPulse 2.4s linear infinite; }
  .flash-2{ animation: flashPulse 2.4s linear infinite; }
  .flash-3{ animation: flashPulse 2.4s linear infinite; }

  @media (prefers-reduced-motion: reduce){
    .pulse{ animation: none !important; opacity: 0 !important; }
    .flash{ animation: none !important; opacity: 1 !important; }
  }

  .diagram-caption{
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 320px;
    width: 100%;
    margin: 4px 0 30px;
  }

  .status{
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 6px;
  }

  .contact{ font-size: 1rem; }

  footer{
    position: fixed;
    left: 0; right: 0; bottom: 26px;
    text-align: center;
  }

  footer p{ font-size: 0.8rem; color: var(--footer-muted); margin: 0; }
  footer a{ color: inherit; text-decoration: none; }
  footer a:hover{ color: var(--muted); }

  @media (max-width: 480px){
    h1{ font-size: 1.7rem; }
    .description{ font-size: 0.95rem; }
  }
</style>
