  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Present Tense",
      "url": "https://present-tense.io",
      "description": "Present Tense sends your screen as text and structure, not video — sharp on any device, and it keeps up even on the venue wifi.",
      "publisher": {
        "@type": "Organization",
        "name": "Sentence Labs",
        "url": "https://sentence-labs.com",
        "email": "hi@sentence-labs.com"
      }
    }
  </script>
