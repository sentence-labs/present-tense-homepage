  <meta property="og:site_name" content="Present Tense">
  <meta property="og:locale" content="en-us">
  <meta property="og:title" content="Present Tense — coming soon">
  <meta property="og:description" content="Present Tense sends your screen as text and structure, not video — sharp on any device, and it keeps up even on the venue wifi. From Sentence Labs.">
